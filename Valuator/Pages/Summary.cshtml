@page
@model Valuator.Pages.SummaryModel
@{
}
@if (@Model.IsLoading)
{
    <p>Оценка ещё не окончена. Пожалуйста, попробуйте обновить страницу</p>
}
else
{
    <p>Страна гражданства: @Model.Country (@Model.Region)</p>
    <p>Оценка содержания: @Model.Rank</p>
    <p>Плагиат: @Model.Similarity</p>
}
